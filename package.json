{
  "name": "buildingos-monorepo",
  "version": "1.0.0",
  "description": "BuildingOS — Intelligent Building Operating System",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,AI-LAYER,FRONTEND\" -c \"blue.bold,magenta.bold,cyan.bold\" \"npm run start --prefix backend\" \"python intelligence/main.py\" \"npm run dev --prefix frontend\"",
    "start:backend": "npm run start --prefix backend",
    "start:ai": "python intelligence/main.py",
    "start:frontend": "npm run dev --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
